@page
@model AlmoxKanban.Pages.LoginModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Entrar no Sistema";
}

<div class="card border-0 shadow-lg" style="width: 100%; max-width: 420px; border-radius: 16px;">
    <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-4 p-3 mb-3 shadow">
                <i class="bi bi-box-seam-fill fs-1"></i>
            </div>
            <h2 class="fw-bold text-dark mb-1">AlmoxKanban</h2>
            <p class="text-muted small">Gestão de Tarefas para Almoxarifado</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 small" role="alert">
                <i class="bi bi-exclamation-octagon-fill"></i>
                <div>@Model.MensagemErro</div>
            </div>
        }

        <form method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Usuario" class="form-label small fw-semibold text-secondary">Usuário</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="Usuario" class="form-control border-start-0" placeholder="Digite seu usuário" autofocus autocomplete="off" />
                </div>
                <span asp-validation-for="Usuario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label small fw-semibold text-secondary">Senha</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Senha" class="form-control border-start-0" placeholder="••••••••" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Senha" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="LembrarMe" class="form-check-input" type="checkbox" id="lembrarMeCheck">
                <label class="form-check-label small text-muted" for="lembrarMeCheck">
                    Lembrar meu acesso neste computador
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                Entrar no Sistema
            </button>
        </form>
    </div>
</div>
