@page
@model AlmoxKanban.Pages.MeuPerfil.IndexModel
@{
    ViewData["Title"] = "Meu Perfil";
    ViewData["Subtitle"] = "Gerenciamento de dados pessoais, foto e credenciais de acesso";
    var u = Model.Usuario;
}

<div class="row g-4">
    <!-- Coluna Esquerda: Edição de Perfil e Senha -->
    <div class="col-lg-5">
        <!-- Dados Básicos -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-4">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-person-gear text-primary me-2"></i>Dados Básicos</h6>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-page-handler="SalvarPerfil" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(u.FotoPerfil))
                        {
                            <img src="@u.FotoPerfil" alt="@u.NomeCompleto" class="rounded-circle shadow-sm border mb-2" style="width: 90px; height: 90px; object-fit: cover;" />
                        }
                        else
                        {
                            var iniciais = string.Join("", u.NomeCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
                            <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold fs-2 shadow-sm mb-2" style="width: 90px; height: 90px;">
                                @iniciais
                            </div>
                        }
                        <div class="small text-muted font-monospace">@@@u.NomeUsuario</div>
                        <div class="badge bg-secondary">@u.Funcao</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label small fw-semibold text-secondary">Nome Exibido</label>
                        <input asp-for="NomeCompleto" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary d-flex align-items-center justify-content-between mb-1">
                            <span>Alterar Foto de Perfil</span>
                        </label>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-upload-action btn-upload-camera" data-target-input="NovaFotoPerfil" data-mode="camera">
                                <i class="bi bi-camera-fill"></i> Tirar Foto (Câmera)
                            </button>
                            <button type="button" class="btn btn-upload-action btn-upload-gallery" data-target-input="NovaFotoPerfil" data-mode="gallery">
                                <i class="bi bi-folder2-open"></i> Galeria / Arquivo
                            </button>
                        </div>
                        <input asp-for="NovaFotoPerfil" type="file" accept="image/*" class="form-control d-none" id="NovaFotoPerfil" />
                        <div class="image-preview-grid mt-2" id="preview-NovaFotoPerfil"></div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Salvar Perfil
                    </button>
                </form>
            </div>
        </div>

        <!-- Alterar Senha -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-4">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-key-fill text-warning me-2"></i>Segurança / Alterar Senha</h6>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-page-handler="TrocarSenha">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="SenhaAtual" class="form-label small fw-semibold text-secondary">Senha Atual</label>
                        <input asp-for="SenhaAtual" type="password" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovaSenha" class="form-label small fw-semibold text-secondary">Nova Senha (mínimo 6 caracteres)</label>
                        <input asp-for="NovaSenha" type="password" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-outline-warning w-100 fw-semibold">
                        <i class="bi bi-shield-lock me-1"></i> Atualizar Minha Senha
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Coluna Direita: Minhas Tarefas -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-4">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-task text-primary me-2"></i>Minhas Tarefas Atribuídas em Aberto (@Model.MinhasTarefasAbertas.Count)</h6>
            </div>
            <div class="card-body p-4">
                @if (!Model.MinhasTarefasAbertas.Any())
                {
                    <p class="text-muted small mb-0">Você não possui nenhuma tarefa pendente ou em andamento atribuída a você no momento.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var t in Model.MinhasTarefasAbertas)
                        {
                            <a href="/Tarefas/Detalhes?id=@t.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-bottom">
                                <div>
                                    <div class="fw-bold text-dark">#@t.Id - @t.Titulo</div>
                                    <small class="text-muted">Prazo: @(t.DataPrazo?.ToString("dd/MM/yyyy HH:mm") ?? "Sem Prazo")</small>
                                </div>
                                <span class="badge bg-light text-dark border">@t.Status</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-4">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-check2-all text-success me-2"></i>Minhas Tarefas Concluídas (@Model.MinhasTarefasConcluidas.Count)</h6>
            </div>
            <div class="card-body p-4">
                @if (!Model.MinhasTarefasConcluidas.Any())
                {
                    <p class="text-muted small mb-0">Nenhuma tarefa concluída por você ainda.</p>
                }
                else
                {
                    <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var t in Model.MinhasTarefasConcluidas)
                        {
                            <a href="/Tarefas/Detalhes?id=@t.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-bottom">
                                <div>
                                    <div class="fw-bold text-dark">#@t.Id - @t.Titulo</div>
                                    <small class="text-muted">Concluída em: @t.DataConclusao?.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Concluída</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
