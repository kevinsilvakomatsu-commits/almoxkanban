@page
@model AlmoxKanban.Pages.Tarefas.CriarModel
@{
    ViewData["Title"] = "Nova Tarefa";
    ViewData["Subtitle"] = "Cadastrar nova demanda operacional para a equipe";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-3 p-sm-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Cadastro de Tarefa</h5>
                    <a href="/" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Voltar ao Kanban</a>
                </div>
            </div>

            <div class="card-body p-3 p-sm-4">
                @if (!string.IsNullOrEmpty(Model.MensagemErro))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.MensagemErro
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <!-- Título -->
                        <div class="col-12">
                            <label asp-for="Titulo" class="form-label fw-semibold text-secondary">Título da Tarefa <span class="text-danger">*</span></label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ex: Organização do Corredor B - Prateleira de Parafusos" autofocus />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <!-- Descrição Breve -->
                        <div class="col-12">
                            <label asp-for="Descricao" class="form-label fw-semibold text-secondary">Descrição Detalhada <span class="text-danger">*</span></label>
                            <textarea asp-for="Descricao" rows="3" class="form-control" placeholder="Descreva claramente o que deve ser realizado pela equipe..."></textarea>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>

                        <!-- Prioridade e Status Inicial -->
                        <div class="col-md-6 col-12">
                            <label asp-for="Prioridade" class="form-label fw-semibold text-secondary">Prioridade</label>
                            <select asp-for="Prioridade" class="form-select" asp-items="Html.GetEnumSelectList<PrioridadeTarefa>()"></select>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="StatusInicial" class="form-label fw-semibold text-secondary">Status Inicial</label>
                            <select asp-for="StatusInicial" class="form-select">
                                <option value="Pendente" selected>Pendente</option>
                                <option value="EmAndamento">Em Andamento</option>
                                <option value="Aguardando">Aguardando</option>
                            </select>
                        </div>

                        <!-- Responsáveis Obrigatórios (Múltiplos) -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary">Responsáveis pela Tarefa <span class="text-danger">* (Selecione pelo menos um)</span></label>
                            <div class="card bg-light border p-3 rounded-3" style="max-height: 220px; overflow-y: auto;">
                                <div class="row g-2">
                                    @foreach (var u in Model.UsuariosEquipe)
                                    {
                                        <div class="col-md-4 col-sm-6 col-12">
                                            <div class="form-check p-2 rounded-2 bg-white border">
                                                <input class="form-check-input ms-0 me-2" type="checkbox" name="ResponsaveisIds" value="@u.Id" id="user_@u.Id"
                                                       @(Model.ResponsaveisIds.Contains(u.Id) ? "checked" : "") />
                                                <label class="form-check-label small fw-semibold" for="user_@u.Id">
                                                    @u.NomeCompleto <span class="text-muted fw-normal d-block" style="font-size: 0.72rem;">@u.Funcao</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <span asp-validation-for="ResponsaveisIds" class="text-danger small"></span>
                        </div>

                        <!-- Prazo: Data e Hora Opcionais (Pré-definidos com Amanhã e +1 Hora) -->
                        <div class="col-md-6 col-12">
                            <label asp-for="DataPrazo" class="form-label fw-semibold text-secondary">Data do Prazo (Opcional)</label>
                            <input asp-for="DataPrazo" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" id="DataPrazo" />
                            <span class="text-muted small">Padrão: dia seguinte. Deixe em branco se for sem prazo.</span>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="HoraPrazo" class="form-label fw-semibold text-secondary">Horário Limite (Opcional)</label>
                            <input asp-for="HoraPrazo" type="time" class="form-control" id="HoraPrazo" />
                            <span class="text-muted small">Padrão: horário atual + 1 hora.</span>
                        </div>

                        <!-- Foto Principal em Destaque -->
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold text-secondary d-flex align-items-center justify-content-between mb-1">
                                <span><i class="bi bi-camera me-1"></i> Foto Principal em Destaque</span>
                            </label>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn-upload-action btn-upload-camera" data-target-input="FotoPrincipal" data-mode="camera">
                                    <i class="bi bi-camera-fill"></i> Tirar Foto Direto
                                </button>
                                <button type="button" class="btn-upload-action btn-upload-gallery" data-target-input="FotoPrincipal" data-mode="gallery">
                                    <i class="bi bi-folder2-open"></i> Galeria / Arquivos
                                </button>
                            </div>
                            <input asp-for="FotoPrincipal" type="file" accept="image/*" class="form-control d-none" id="FotoPrincipal" />
                            <div class="image-preview-grid mt-2" id="preview-FotoPrincipal"></div>
                            <span class="text-muted small d-block">Foto exibida no cartão do Kanban. Tire com a câmera do celular ou selecione da galeria.</span>
                        </div>

                        <!-- Fotos Adicionais -->
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold text-secondary d-flex align-items-center justify-content-between mb-1">
                                <span><i class="bi bi-images me-1"></i> Fotos Adicionais / Anexos</span>
                            </label>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn-upload-action btn-upload-camera" data-target-input="FotosAdicionais" data-mode="camera">
                                    <i class="bi bi-camera-fill"></i> Tirar Foto Direto
                                </button>
                                <button type="button" class="btn-upload-action btn-upload-gallery" data-target-input="FotosAdicionais" data-mode="gallery">
                                    <i class="bi bi-folder2-open"></i> Galeria / Arquivos
                                </button>
                            </div>
                            <input asp-for="FotosAdicionais" type="file" accept="image/*" multiple class="form-control d-none" id="FotosAdicionais" />
                            <div class="image-preview-grid mt-2" id="preview-FotosAdicionais"></div>
                            <span class="text-muted small d-block">Pode tirar várias fotos com o celular ou selecionar múltiplas fotos da situação.</span>
                        </div>

                        <!-- Observações Gerais -->
                        <div class="col-12">
                            <label asp-for="Observacoes" class="form-label fw-semibold text-secondary">Observações ou Recomendações de Segurança</label>
                            <textarea asp-for="Observacoes" rows="2" class="form-control" placeholder="Ex: Usar EPI (luvas e bota de bico de aço); empilhadeira disponível até 15h."></textarea>
                        </div>
                    </div>

                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="/" class="btn btn-light px-4 py-2">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Criar Tarefa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
