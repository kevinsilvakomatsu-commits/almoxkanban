@page
@model AlmoxKanban.Pages.Tarefas.EditarModel
@{
    ViewData["Title"] = $"Editar Tarefa #{Model.Id}";
    ViewData["Subtitle"] = "Alterar dados e responsáveis da tarefa";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-3 p-sm-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edição de Tarefa</h5>
                    <a href="/Tarefas/Detalhes?id=@Model.Id" class="btn btn-outline-secondary btn-sm">Voltar</a>
                </div>
            </div>

            <div class="card-body p-3 p-sm-4">
                @if (!string.IsNullOrEmpty(Model.MensagemErro))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.MensagemErro
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Titulo" class="form-label fw-semibold text-secondary">Título da Tarefa <span class="text-danger">*</span></label>
                            <input asp-for="Titulo" class="form-control" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descricao" class="form-label fw-semibold text-secondary">Descrição Detalhada <span class="text-danger">*</span></label>
                            <textarea asp-for="Descricao" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="Prioridade" class="form-label fw-semibold text-secondary">Prioridade</label>
                            <select asp-for="Prioridade" class="form-select" asp-items="Html.GetEnumSelectList<PrioridadeTarefa>()"></select>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="DataPrazo" class="form-label fw-semibold text-secondary">Data do Prazo</label>
                            <input asp-for="DataPrazo" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" id="DataPrazo" />
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="HoraPrazo" class="form-label fw-semibold text-secondary">Horário Limite</label>
                            <input asp-for="HoraPrazo" type="time" class="form-control" id="HoraPrazo" />
                        </div>

                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold text-secondary d-flex align-items-center justify-content-between mb-1">
                                <span><i class="bi bi-camera me-1"></i> Trocar Foto Principal</span>
                            </label>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn btn-upload-action btn-upload-camera" data-target-input="NovaFotoPrincipal" data-mode="camera">
                                    <i class="bi bi-camera-fill"></i> Tirar Foto Direto
                                </button>
                                <button type="button" class="btn btn-upload-action btn-upload-gallery" data-target-input="NovaFotoPrincipal" data-mode="gallery">
                                    <i class="bi bi-folder2-open"></i> Galeria / Arquivo
                                </button>
                            </div>
                            <input asp-for="NovaFotoPrincipal" type="file" accept="image/*" class="form-control d-none" id="NovaFotoPrincipal" />
                            <div class="image-preview-grid mt-2" id="preview-NovaFotoPrincipal"></div>
                            @if (!string.IsNullOrEmpty(Model.FotoPrincipalAtual))
                            {
                                <div class="mt-1 small text-muted">Foto atual cadastrada. Tire ou envie uma nova caso queira substituí-la.</div>
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary">Responsáveis pela Tarefa <span class="text-danger">*</span></label>
                            <div class="card bg-light border p-3 rounded-3" style="max-height: 220px; overflow-y: auto;">
                                <div class="row g-2">
                                    @foreach (var u in Model.UsuariosEquipe)
                                    {
                                        <div class="col-md-4 col-sm-6 col-12">
                                            <div class="form-check p-2 rounded-2 bg-white border">
                                                <input class="form-check-input ms-0 me-2" type="checkbox" name="ResponsaveisIds" value="@u.Id" id="user_@u.Id"
                                                       @(Model.ResponsaveisIds.Contains(u.Id) ? "checked" : "") />
                                                <label class="form-check-label small fw-semibold" for="user_@u.Id">
                                                    @u.NomeCompleto <span class="text-muted fw-normal d-block" style="font-size: 0.72rem;">@u.Funcao</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <span asp-validation-for="ResponsaveisIds" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Observacoes" class="form-label fw-semibold text-secondary">Observações</label>
                            <textarea asp-for="Observacoes" rows="2" class="form-control"></textarea>
                        </div>
                    </div>

                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="/Tarefas/Detalhes?id=@Model.Id" class="btn btn-light px-4 py-2">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
