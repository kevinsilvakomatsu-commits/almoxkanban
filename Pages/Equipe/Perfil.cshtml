@page
@model AlmoxKanban.Pages.Equipe.PerfilModel
@{
    var u = Model.Usuario!;
    ViewData["Title"] = $"Integrante: {u.NomeCompleto}";
    ViewData["Subtitle"] = $"Acompanhamento operacional de {u.NomeCompleto}";
}

<div class="row g-4">
    <!-- Coluna Esquerda: Dados do Usuário -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4">
            <div class="mb-3">
                @if (!string.IsNullOrEmpty(u.FotoPerfil))
                {
                    <img src="@u.FotoPerfil" alt="@u.NomeCompleto" class="rounded-circle shadow-sm border" style="width: 100px; height: 100px; object-fit: cover;" />
                }
                else
                {
                    var iniciais = string.Join("", u.NomeCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold fs-2 shadow-sm" style="width: 100px; height: 100px;">
                        @iniciais
                    </div>
                }
            </div>

            <h5 class="fw-bold text-dark mb-1">@u.NomeCompleto</h5>
            <div class="badge bg-secondary mb-2">@u.Funcao</div>
            <div class="text-muted small mb-3">@@@u.NomeUsuario</div>

            <div class="d-flex justify-content-center gap-2 mb-3">
                @if (u.Ativo)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Ativo</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inativo</span>
                }
                @if (u.IsAdmin)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Líder/Admin</span>
                }
            </div>

            <div class="row g-2 border-top pt-3 text-center">
                <div class="col-6">
                    <span class="text-muted small d-block">Em Aberto</span>
                    <strong class="fs-4 text-warning">@Model.TarefasAtuais.Count</strong>
                </div>
                <div class="col-6 border-start">
                    <span class="text-muted small d-block">Concluídas</span>
                    <strong class="fs-4 text-success">@Model.TarefasConcluidas.Count</strong>
                </div>
            </div>

            <div class="mt-4">
                <a href="/Equipe/Editar?id=@u.Id" class="btn btn-outline-primary btn-sm w-100">
                    <i class="bi bi-pencil-square me-1"></i> Editar Cadastro
                </a>
            </div>
        </div>
    </div>

    <!-- Coluna Direita: Tarefas do Colaborador -->
    <div class="col-lg-8">
        <!-- Tarefas em Aberto -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history text-warning me-2"></i>Tarefas em Aberto Atribuídas (@Model.TarefasAtuais.Count)</h6>
            </div>
            <div class="card-body p-4">
                @if (!Model.TarefasAtuais.Any())
                {
                    <p class="text-muted small mb-0">Nenhuma tarefa pendente ou em andamento no momento.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var t in Model.TarefasAtuais)
                        {
                            <a href="/Tarefas/Detalhes?id=@t.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-bottom">
                                <div>
                                    <div class="fw-bold text-dark">#@t.Id - @t.Titulo</div>
                                    <small class="text-muted">Prazo: @(t.DataPrazo?.ToString("dd/MM/yyyy HH:mm") ?? "Sem Prazo")</small>
                                </div>
                                <span class="badge bg-light text-dark border">@t.Status</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Tarefas Concluídas -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-check-circle-fill text-success me-2"></i>Histórico de Tarefas Concluídas (@Model.TarefasConcluidas.Count)</h6>
            </div>
            <div class="card-body p-4">
                @if (!Model.TarefasConcluidas.Any())
                {
                    <p class="text-muted small mb-0">Nenhuma tarefa concluída por este colaborador ainda.</p>
                }
                else
                {
                    <div class="list-group list-group-flush" style="max-height: 350px; overflow-y: auto;">
                        @foreach (var t in Model.TarefasConcluidas)
                        {
                            <a href="/Tarefas/Detalhes?id=@t.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-bottom">
                                <div>
                                    <div class="fw-bold text-dark">#@t.Id - @t.Titulo</div>
                                    <small class="text-muted">Concluída em: @t.DataConclusao?.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Concluída</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
