@page
@model AlmoxKanban.Pages.Equipe.CriarModel
@{
    ViewData["Title"] = "Novo Integrante";
    ViewData["Subtitle"] = "Cadastrar colaborador na equipe do almoxarifado";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-person-plus text-primary me-2"></i>Cadastro de Usuário</h5>
                    <a href="/Equipe" class="btn btn-outline-secondary btn-sm">Voltar</a>
                </div>
            </div>

            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.MensagemErro))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.MensagemErro
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label fw-semibold text-secondary">Nome Completo <span class="text-danger">*</span></label>
                        <input asp-for="NomeCompleto" class="form-control" placeholder="Ex: Roberto Carlos Pereira" autofocus />
                        <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NomeUsuario" class="form-label fw-semibold text-secondary">Nome de Usuário (Login) <span class="text-danger">*</span></label>
                            <input asp-for="NomeUsuario" class="form-control" placeholder="Ex: roberto.pereira" />
                            <span asp-validation-for="NomeUsuario" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SenhaInicial" class="form-label fw-semibold text-secondary">Senha Inicial <span class="text-danger">*</span></label>
                            <input asp-for="SenhaInicial" type="text" class="form-control" />
                            <span asp-validation-for="SenhaInicial" class="text-danger small"></span>
                            <div class="form-text small">Será solicitada a troca no primeiro login.</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Funcao" class="form-label fw-semibold text-secondary">Função / Cargo <span class="text-danger">*</span></label>
                            <input asp-for="Funcao" class="form-control" placeholder="Ex: Conferente, Estoquista, Almoxarife" />
                            <span asp-validation-for="Funcao" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary d-flex align-items-center justify-content-between mb-1">
                                <span>Foto de Perfil (Opcional)</span>
                            </label>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn btn-upload-action btn-upload-camera" data-target-input="FotoPerfil" data-mode="camera">
                                    <i class="bi bi-camera-fill"></i> Tirar Foto (Câmera)
                                </button>
                                <button type="button" class="btn btn-upload-action btn-upload-gallery" data-target-input="FotoPerfil" data-mode="gallery">
                                    <i class="bi bi-folder2-open"></i> Galeria / Arquivo
                                </button>
                            </div>
                            <input asp-for="FotoPerfil" type="file" accept="image/*" class="form-control d-none" id="FotoPerfil" />
                            <div class="image-preview-grid mt-2" id="preview-FotoPerfil"></div>
                        </div>
                    </div>

                    <div class="card bg-light border p-3 rounded-3 mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsAdmin" class="form-check-input" type="checkbox" id="chkAdmin">
                            <label class="form-check-label fw-bold text-dark" for="chkAdmin">
                                Perfil de Administrador / Líder
                            </label>
                        </div>
                        <div class="small text-muted mt-1">
                            Líderes podem cadastrar integrantes, editar/excluir qualquer tarefa, reabrir tarefas concluídas e gerar backups do sistema.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a href="/Equipe" class="btn btn-light px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Cadastrar Integrante
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
