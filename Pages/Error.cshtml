@page
@model ErrorModel
@{
    ViewData["Title"] = "Ocorreu um Erro";
}

<div class="card border-0 shadow-sm rounded-4 p-5 text-center my-5">
    <div class="text-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill" style="font-size: 3.5rem;"></i>
    </div>
    <h2 class="fw-bold text-dark mb-2">Ops! Ocorreu um problema inesperado.</h2>
    <p class="text-muted mb-4">A operação solicitada não pôde ser completada. O erro foi registrado no sistema.</p>

    @if (Model.ShowRequestId)
    {
        <div class="p-2 bg-light rounded text-monospace small mb-4">
            Código de Rastreamento: <code>@Model.RequestId</code>
        </div>
    }

    <div>
        <a href="/" class="btn btn-primary px-4 fw-semibold">
            <i class="bi bi-house-door-fill me-1"></i> Retornar ao Kanban
        </a>
    </div>
</div>
