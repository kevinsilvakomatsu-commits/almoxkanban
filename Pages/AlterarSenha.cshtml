@page
@model AlmoxKanban.Pages.AlterarSenhaModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Definir Nova Senha";
}

<div class="card border-0 shadow-lg" style="width: 100%; max-width: 440px; border-radius: 16px;">
    <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-warning text-dark rounded-4 p-3 mb-3 shadow">
                <i class="bi bi-shield-lock-fill fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">
                @(Model.PrimeiroAcesso ? "Troca Obrigatória de Senha" : "Alterar Senha")
            </h3>
            <p class="text-muted small">
                @(Model.PrimeiroAcesso ? "Por segurança, você deve alterar sua senha inicial antes de continuar." : "Digite sua nova senha abaixo.")
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 small" role="alert">
                <i class="bi bi-exclamation-octagon-fill"></i>
                <div>@Model.MensagemErro</div>
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            @if (!Model.PrimeiroAcesso)
            {
                <div class="mb-3">
                    <label asp-for="SenhaAtual" class="form-label small fw-semibold text-secondary">Senha Atual</label>
                    <input asp-for="SenhaAtual" type="password" class="form-control" />
                    <span asp-validation-for="SenhaAtual" class="text-danger small"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="NovaSenha" class="form-label small fw-semibold text-secondary">Nova Senha (mínimo 6 caracteres)</label>
                <input asp-for="NovaSenha" type="password" class="form-control" autofocus />
                <span asp-validation-for="NovaSenha" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmarSenha" class="form-label small fw-semibold text-secondary">Confirme a Nova Senha</label>
                <input asp-for="ConfirmarSenha" type="password" class="form-control" />
                <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                Salvar Nova Senha
            </button>
        </form>
    </div>
</div>
